# Database (Vercel Postgres)
DATABASE_URL="postgres://..."
DATABASE_URL_UNPOOLED="postgres://..."

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# HR accounts — comma-separated list
# Format: email:password:name:role
# Role is optional (HR or ADMIN). Defaults to HR.
# Example:
# HR_USERS="hr@thuishaven.nl:changeme:HR Thuishaven:ADMIN,finance@thuishaven.nl:changeme:Finance"
HR_USERS="hr@thuishaven.nl:changeme:HR Thuishaven:ADMIN"

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-64-hex-char-encryption-key"

# Brevo transactional email (same workspace as other Thuishaven apps)
# Reuse BREVO_MCP_TOKEN from the other project; it is the API key this app sends with.
BREVO_API_KEY=""
BREVO_MCP_TOKEN=""
AUTH_FROM_EMAIL="noreply@thuishaven.nl"
BREVO_SENDER_NAME="Thuishaven Events"
HR_ALERT_EMAIL="bas@thuishaven.nl,quinty@thuishaven.nl"

# Daily contract-expiry cron (optional; Vercel Cron sends this as Bearer)
CRON_SECRET=""

# Vercel Blob (private store for passport / ID-card uploads)
# Created via: vercel blob create-store <name> --access private --yes
BLOB_READ_WRITE_TOKEN=""

# App
NEXT_PUBLIC_URL="http://localhost:3000"

# Google Maps / Places (address autocomplete on the form)
# Enable "Maps JavaScript API" + "Places API (New)" in Google Cloud Console.
# Restrict the key by HTTP referrer (localhost + your production domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
