generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  bsn         String   @unique

  street      String
  houseNumber String
  postalCode  String
  city        String

  email String
  phone String

  iban String

  initials     String?
  namePrefix   String?
  placeOfBirth String?
  gender       Gender?
  nationality  String?
  maritalStatus MaritalStatus?
  applyPayrollTaxCredit Boolean?
  receivesBenefits      Boolean?

  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions      Submission[]
  alerts           Alert[]
  contracts        Contract[]
  identityDocument IdentityDocument?

  @@index([lastName, dateOfBirth])
}

/** Passport / ID-card copy — required on first registration, stored on the employee profile. */
model IdentityDocument {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  blobUrl      String
  pathname     String
  contentType  String
  originalName String
  sizeBytes    Int

  uploadedAt DateTime @default(now())
}

model Submission {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  eventDate  DateTime
  department String?

  startTime    String
  endTime      String
  breakMinutes Int     @default(0)

  hourlyRate Decimal @db.Decimal(10, 2)
  totalHours Decimal @db.Decimal(10, 2)
  totalPay   Decimal @db.Decimal(10, 2)

  signatureData String? @db.Text

  pdfUrl         String?
  pdfGeneratedAt DateTime?

  status     SubmissionStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  editedAt      DateTime?
  editedBy      String?
  editedByEmail String?

  @@index([employeeId])
  @@index([eventDate])
  @@index([createdAt])
}

model Alert {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       AlertType
  message    String

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([acknowledged, createdAt])
  @@index([contractId, type])
}

model PayRate {
  id           String   @id @default(cuid())
  effectiveFrom DateTime @unique
  under20Rate  Decimal  @db.Decimal(10, 2)
  over20Rate   Decimal  @db.Decimal(10, 2)
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contract {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  version        Int
  status         ContractStatus @default(INVITED)
  templateVersion String        @default("oproep-2026-09")

  startDate  DateTime
  endDate    DateTime
  hourlyRate Decimal  @db.Decimal(10, 2)

  inviteTokenHash String    @unique
  invitedAt       DateTime  @default(now())
  invitedBy       String?
  verifiedAt      DateTime?

  employeeSignatureData    String?   @db.Text
  reglementSignatureData   String?   @db.Text
  employeeSignedAt         DateTime?

  employerSignatureData String?   @db.Text
  employerSignedAt      DateTime?
  employerSignedBy      String?

  contractPdfPathname    String?
  contractPdfUrl         String?
  reglementPdfPathname   String?
  reglementPdfUrl        String?
  fullySignedPdfPathname String?
  fullySignedPdfUrl      String?

  signedCopyEmailedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts Alert[]

  @@unique([employeeId, version])
  @@index([employeeId, status])
  @@index([endDate, status])
}

enum SubmissionStatus {
  PENDING
  REVIEWED
  BLOCKED
}

enum AlertType {
  THREE_SHIFTS
  FOUR_SHIFTS
  CONTRACT_NEEDED
  CONTRACT_SIGNED
  CONTRACT_EXPIRING
}

enum ContractStatus {
  INVITED
  EMPLOYEE_SIGNED
  COUNTERSIGNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  MARRIED
  UNMARRIED
}
