generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  bsn         String   @unique

  street      String
  houseNumber String
  postalCode  String
  city        String

  email String
  phone String

  iban String

  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions      Submission[]
  alerts           Alert[]
  identityDocument IdentityDocument?

  @@index([lastName, dateOfBirth])
}

/** Passport / ID-card copy — required on first registration, stored on the employee profile. */
model IdentityDocument {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  blobUrl      String
  pathname     String
  contentType  String
  originalName String
  sizeBytes    Int

  uploadedAt DateTime @default(now())
}

model Submission {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  eventDate  DateTime
  department String?

  startTime    String
  endTime      String
  breakMinutes Int     @default(0)

  hourlyRate Decimal @db.Decimal(10, 2)
  totalHours Decimal @db.Decimal(10, 2)
  totalPay   Decimal @db.Decimal(10, 2)

  signatureData String? @db.Text

  pdfUrl         String?
  pdfGeneratedAt DateTime?

  status     SubmissionStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([employeeId])
  @@index([eventDate])
  @@index([createdAt])
}

model Alert {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       AlertType
  message    String

  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([acknowledged, createdAt])
}

enum SubmissionStatus {
  PENDING
  REVIEWED
  BLOCKED
}

enum AlertType {
  THREE_SHIFTS
  FOUR_SHIFTS
  CONTRACT_NEEDED
}
